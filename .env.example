# LaptopPulse — Environment Variables (copy to .env for local dev)
# Production: use  python main.py --setup-key  instead

# ── API Keys (set ONE — app auto-detects by prefix) ───────────────────────────
# Gemini (FREE — recommended): key starts with AIza...
# Get it free at: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...your_key_here

# Alternative Gemini env var name (same key, either works)
# GOOGLE_API_KEY=AIza...your_key_here

# Anthropic Claude (paid, ~$0.003/report): key starts with sk-ant-...
# Get it at: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...your_key_here

# ── Dev overrides ─────────────────────────────────────────────────────────────
# LAPTOPPULSE_LOG_DIR=C:\custom\path\to\logs
# LAPTOPPULSE_INTERVAL=30
# LAPTOPPULSE_DEV_MODE=true
